---
layout: base.njk
permalink: /about/
active: about
bodyClass: on-paper
title: About
description: "Dr. Adán Alejándro Fernández, organist, harpsichordist, and conductor. Biography, positions, education, and honors."
---
<section class="page-head split">
  <div class="wrap">
  <div class="head-text">
    <p class="eyebrow">Biography</p>
    <h1>A musician of the <em>Church.</em></h1>
    <p class="lede">{{ bio.oneLine }}</p>
  </div>
  <figure class="head-photo wide"><img src="/assets/img/press/console-smiling-web.jpg" alt="" width="1600" height="1067" loading="eager"></figure>
  </div>
</section>

<section class="section">
  <div class="wrap two-col">
    <div class="prose reveal">
      {%- for p in bio.long %}
      <p{% if loop.first %} class="first"{% endif %}>{{ p }}</p>
      {%- endfor %}
      <div class="cta-row">
        <a class="btn btn-outline" href="{{ site.cv }}" download>Download the full CV (PDF)</a>
      </div>
    </div>
    <figure class="portrait-frame reveal" style="margin:0">
      <img src="/assets/img/portrait.jpg" alt="Portrait of Adán Fernández" width="1200" height="1200" loading="lazy">
    </figure>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Positions</span><span class="rule"></span></div>
    <h2 class="reveal" style="margin-bottom:2rem">Where he serves.</h2>
    <div class="posts">
    {%- for r in positions.items %}
      <div class="post reveal">
        <p class="post-title">{{ r.title }}</p>
        <h3>{{ r.place }}</h3>
        <p class="post-city">{{ r.city }}</p>
        {%- if r.note %}<p class="post-note">{{ r.note }}</p>{% endif %}
      </div>
    {%- endfor %}
    </div>
  </div>
</section>

<section class="section tint">
  <div class="wrap two-col">
    <div class="reveal">
      <div class="rule-head"><span class="lbl">Education</span><span class="rule"></span></div>
      <div class="degrees">
      {%- for e in education.degrees %}
        <div class="degree">
          <span class="deg-year">{{ e.year }}</span>
          <div><h3>{{ e.school }}</h3><p class="deg-award">{{ e.award }}</p>{% if e.note %}<p class="deg-note">{{ e.note }}</p>{% endif %}</div>
        </div>
      {%- endfor %}
      </div>
    </div>
    <div class="reveal">
      <div class="rule-head"><span class="lbl">Fellowships &amp; awards</span><span class="rule"></span></div>
      {% set items = education.honors %}{% include "biblio.njk" %}
      <p class="fine" style="margin-top:1.4rem">{{ education.credential }}</p>
      <div class="rule-head" style="margin-top:2.4rem"><span class="lbl">Member of</span><span class="rule"></span></div>
      <ul class="pills">
      {%- for m in education.memberships %}<li>{{ m }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

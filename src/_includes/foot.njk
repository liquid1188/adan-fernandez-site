<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="foot-home" href="/" aria-label="Home">
        {% set cls = "foot-mark" %}{% include "mark.njk" %}
        <span class="foot-name">{{ site.name }}</span>
      </a>
      <p class="foot-roles">{{ site.roles }}</p>
      <ul class="social" aria-label="Elsewhere">
      {%- for s in site.social %}
        <li><a href="{{ s.url }}" rel="noopener" aria-label="{{ s.name }}" title="{{ s.name }}">{% set icon = s.icon %}{% include "icons.njk" %}</a></li>
      {%- endfor %}
      </ul>
    </div>
    <nav class="foot-col" aria-label="Footer">
      <p class="foot-h">The work</p>
      <a href="/about/">About</a>
      <a href="/listen/">Listen</a>
      <a href="/performing/">Performing</a>
      <a href="/teaching/">Teaching</a>
      <a href="/writing/">Writing</a>
    </nav>
    <nav class="foot-col" aria-label="Footer, more">
      <p class="foot-h">Get in touch</p>
      <a href="/gallery/">Gallery</a>
      <a href="/calendar/">Calendar</a>
      <a href="/contact/">Contact</a>
      <a href="/press-kit/">Press kit</a>
      <a href="{{ site.cv }}" download>Curriculum vitae</a>
    </nav>
    <div class="foot-col">
      <p class="foot-h">Management</p>
      <a href="{{ site.management.url }}" rel="noopener">{{ site.management.name }}</a>
      <a href="mailto:{{ site.management.email }}">{{ site.management.email }}</a>
      <p class="foot-h" style="margin-top:1.4rem">Direct</p>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
    </div>
  </div>
  <div class="wrap foot-rule">
    <p>&copy; <span id="year">2026</span> {{ site.name }} &middot; <a href="/admin/" rel="nofollow">Site editor</a></p>
    <p class="lang-foot"><button class="lang-toggle lang-toggle--foot notranslate" type="button" data-lang-toggle lang="es">Español</button><button class="lang-toggle view-toggle" type="button" id="viewToggle">View desktop version</button><span class="gt-note" hidden>Traducción automática de Google.</span></p>
    <p>{{ site.photoCredit }} Site by <a href="https://lickitysplitweb.com" rel="noopener">Lickity Split Web Design</a>.</p>
  </div>
</footer>

<ul class="biblio">
{%- for it in items %}
  <li class="reveal">
    <span class="bib-title">{% if it.link %}<a href="{{ it.link }}" rel="noopener">{{ it.title or it.text }}<span class="lk" aria-hidden="true">&nearr;</span></a>{% else %}{{ it.title or it.text }}{% endif %}</span>
    <span class="bib-sub">{% if it.where %}<em>{{ it.where }}</em> &middot; {% endif %}{% if it.kind %}{{ it.kind }}{% if it.year %} &middot; {% endif %}{% endif %}{{ it.year }}</span>
  </li>
{%- endfor %}
</ul>
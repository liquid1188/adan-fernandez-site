<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.shortName }}{% else %}{{ site.name }} | Organist, Harpsichordist &amp; Conductor{% endif %}</title>
<meta name="description" content="{{ description or bio.oneLine }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
<meta property="og:title" content="{% if title %}{{ title }} · {{ site.shortName }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or bio.oneLine }}">
<meta property="og:image" content="{{ site.url }}/assets/img/hero-organ.jpg">
<meta property="og:site_name" content="{{ site.name }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/assets/img/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<meta name="theme-color" content="#101a26">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css?v=39">
{% if page.url == '/' %}<link rel="preload" as="image" href="/assets/img/hero-organ.jpg" fetchpriority="high">{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}/",
  "image": "{{ site.url }}/assets/img/portrait.jpg",
  "jobTitle": "Organist, Harpsichordist, and Conductor",
  "email": "mailto:{{ site.email }}",
  "telephone": "{{ site.phoneHref }}",
  "worksFor": { "@type": "Organization", "name": "Holy Family Catholic Church, Glendale" },
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "University of Southern California" },
    { "@type": "CollegeOrUniversity", "name": "Claremont Graduate University" },
    { "@type": "CollegeOrUniversity", "name": "Azusa Pacific University" }
  ],
  "sameAs": ["{{ site.youtube }}", "{{ site.management.url }}"]
}
</script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{% include "nav.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "foot.njk" %}
<script src="/assets/js/site.js?v=2" defer></script>
{% if page.url == '/' %}<script src="/assets/js/organ.js?v=1" defer></script>{% endif %}
</body>
</html>

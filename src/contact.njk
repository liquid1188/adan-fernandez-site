        <div class="rule-head"><span class="lbl">Management</span><span class="rule"></span></div>
        <p class="lede">Represented by <a href="{{ site.management.url }}" rel="noopener" style="border-bottom:1px solid var(--brass)">{{ site.management.name }}</a>. For bookings through management, write to {{ site.management.contact }} at <a href="mailto:{{ site.management.email }}" style="border-bottom:1px solid var(--brass)">{{ site.management.email }}</a>.</p>
        <div class="cta-row"><a class="btn btn-ghost" href="/press-kit/">Press kit &amp; photos</a></div>
      </div>
    </div>
  </div>

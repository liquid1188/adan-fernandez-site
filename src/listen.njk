---
layout: base.njk
permalink: /listen/
active: listen
bodyClass: on-paper
title: Listen
description: "Recordings of Adán Fernández at the organ and harpsichord, conducting choral and orchestral works, and his own compositions."
---
<section class="page-head split">
  <div class="wrap">
  <div class="head-text">
    <p class="eyebrow">Listen</p>
    <h1>Recordings.</h1>
    <p class="lede">Organ and harpsichord, choral and orchestral conducting, his own music, and a few lectures. Everything here is on his <a href="{{ site.youtube }}" rel="noopener" style="border-bottom:1px solid var(--brass)">YouTube channel</a>, which holds a good deal more.</p>
  </div>
  <figure class="head-photo"><img src="/assets/img/press/conducting-bw-web.jpg" alt="" width="960" height="960" style="object-position:50% 30%" loading="eager"></figure>
  </div>
</section>

{%- for g in videos.items | groupBy('group') %}
<section class="section{% if loop.index0 % 2 == 1 %} tint{% endif %}">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">{{ g.name }}</span><span class="rule"></span></div>
    <div class="video-grid">
    {%- for v in g.items %}
      <figure class="vid reveal">
        <div class="frame" data-yt="{{ v.id }}" role="button" tabindex="0" aria-label="Play {{ v.piece }} by {{ v.composer }}">
          <img src="https://i.ytimg.com/vi/{{ v.id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg'" alt="" loading="lazy" width="1280" height="720">
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        </div>
        <figcaption>
          <span class="piece">{{ v.piece }}</span>
          <span class="composer">{{ v.composer }}</span>
          {%- if v.note %}<span class="note">{{ v.note }}</span>{% endif %}
        </figcaption>
      </figure>
    {%- endfor %}
    </div>
  </div>
</section>
{%- endfor %}

<section class="section dark">
  <div class="wrap" style="text-align:center">
    <h2 class="reveal">More <em>on the channel.</em></h2>
    <p class="lede reveal" style="margin:1rem auto 0">Weekly liturgies, full concerts, and the children's choirs at Holy Family.</p>
    <div class="cta-row reveal" style="justify-content:center">
      <a class="btn btn-brass" href="{{ site.youtube }}" rel="noopener">Visit the YouTube channel</a>
    </div>
  </div>
</section>

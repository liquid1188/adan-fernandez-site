---
layout: base.njk
permalink: /
active: home
---
{%- set feat = [] %}
{%- for id in videos.featured %}{% for v in videos.items %}{% if v.id == id %}{% set feat = (feat.push(v), feat) %}{% endif %}{% endfor %}{% endfor %}
{%- set next = performances.items | upcoming | limit(3) %}

<section class="hero">
  <img class="hero-img" src="/assets/img/hero-organ.jpg" alt="Adán Fernández at the organ console" width="1920" height="1280" fetchpriority="high">
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <p class="eyebrow hero-eyebrow">{{ site.roles }}</p>
    <h1>Adán Alejándro<br>Fernández</h1>
    <p class="hero-sub"><span class="line"><strong>Director of Music and Liturgy</strong>, Holy Family Catholic Church, Glendale</span><span class="line"><strong>University Organist</strong>, California Lutheran University</span></p>
    <div class="cta-row">
      <a class="btn btn-brass" href="/listen/">Hear him play</a>
      <a class="btn btn-ghost" href="/contact/">Book a recital</a>
    </div>
  </div>
</section>

<div class="statement">
  <div class="wrap">
    <p>Working where the pipe organ, the Catholic liturgy, <em>and the sacred music of Latin America meet.</em></p>
  </div>
</div>

<section class="section">
  <div class="wrap two-col">
    <div class="reveal">
      <div class="rule-head"><span class="lbl">Biography</span><span class="rule"></span></div>
      <div class="prose">
        <p class="first">{{ bio.short }}</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-outline" href="/about/">Read the full biography</a>
      </div>
    </div>
    <figure class="portrait-frame reveal" style="margin:0">
      <img src="/assets/img/portrait.jpg" alt="Portrait of Adán Fernández" width="1200" height="1200" loading="lazy">
    </figure>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Listen</span><span class="rule"></span></div>
    <h2 class="reveal">At the console, <em>and in front of the choir.</em></h2>
    <p class="lede reveal" style="margin-top:1rem;margin-bottom:2.6rem">Three recordings to start with.</p>
    <div class="video-grid">
    {%- for v in feat %}
      <figure class="vid reveal">
        <div class="frame" data-yt="{{ v.id }}" role="button" tabindex="0" aria-label="Play {{ v.piece }} by {{ v.composer }}">
          <img src="https://i.ytimg.com/vi/{{ v.id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg'" alt="" loading="lazy" width="1280" height="720">
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        </div>
        <figcaption><span class="piece">{{ v.piece }}</span><span class="composer">{{ v.composer }}</span>{% if v.note %}<span class="note">{{ v.note }}</span>{% endif %}</figcaption>
      </figure>
    {%- endfor %}
    </div>
    <div class="cta-row"><a class="btn btn-ghost" href="/listen/">All recordings</a></div>
  </div>
</section>

{%- if next | length %}
<section class="section tint">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Next</span><span class="rule"></span></div>
    <ol class="events">
    {%- for e in next %}
      <li class="event reveal">
        <div class="date"><span class="m">{{ e.date | mon }}</span><span class="d">{{ e.date | day }}</span><span class="y">{{ e.date | year }}</span></div>
        <div>
          <h3>{{ e.title }}{% if e.tag %}<span class="tag">{{ e.tag }}</span>{% endif %}</h3>
          <p>{{ e.venue }} &middot; {{ e.city }}</p>
        </div>
      </li>
    {%- endfor %}
    </ol>
    <div class="cta-row"><a class="btn btn-outline" href="/calendar/">Full calendar</a></div>
  </div>
</section>
{%- endif %}


<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">In print</span><span class="rule"></span></div>
    <div class="feat-grid">
    {%- for f in writing.featured | limit(2) %}
      <article class="feat reveal{% if f.page %} has-page{% endif %}">
        {%- if f.page %}<a class="feat-page" href="{{ f.link }}" rel="noopener" tabindex="-1" aria-hidden="true"><img src="{{ f.page }}" alt="" width="560" height="792" loading="lazy"></a>{% endif %}
        <div class="feat-body">
        <p class="feat-kicker">{{ f.kicker }}</p>
        <p class="feat-cite">{{ f.cite }}</p>
        <h3><a href="{{ f.link }}" rel="noopener">{{ f.title }}</a></h3>
        <a class="go" href="{{ f.link }}" rel="noopener">{{ f.cta }} &rarr;</a>
        </div>
      </article>
    {%- endfor %}
    </div>
    <div class="cta-row"><a class="btn btn-outline" href="/writing/">All writing and scholarship</a></div>
  </div>
</section>

<section class="affil">
  <div class="wrap">
    <p class="eyebrow" style="text-align:center">Affiliations</p>
    <ul class="affil-row">
    {%- for a in affiliations.items %}
      <li><a href="{{ a.url }}" rel="noopener" title="{{ a.name }}">{% if a.img %}<img src="{{ a.img }}" alt="{{ a.name }}" width="{{ a.w }}" height="{{ a.h }}" loading="lazy">{% else %}<span class="wordmark">{{ a.text }}{% if a.sub %}<small>{{ a.sub }}</small>{% endif %}</span>{% endif %}</a></li>
    {%- endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Work with Adán</span><span class="rule"></span></div>
    <div class="cards numbered">
      <a class="card card-photo reveal" href="/performing/">
        <img src="/assets/img/press/console-wide-web.jpg" alt="" width="1600" height="1067" loading="lazy" style="object-position:50% 45%">
        <h3>Performing</h3>
        <p>Organ and harpsichord recitals, concerto appearances, and conducting engagements, from parish churches to Walt Disney Concert Hall.</p>
        <span class="go">See the repertoire &rarr;</span>
      </a>
      <a class="card card-photo reveal" href="/teaching/">
        <img src="/assets/img/press/conducting-orchestra-web.jpg" alt="" width="638" height="638" loading="lazy" style="object-position:50% 30%">
        <h3>Teaching</h3>
        <p>An organ and piano studio at Cal Lutheran, theory at the Colburn School, and masterclasses and residencies for church musicians.</p>
        <span class="go">What he teaches &rarr;</span>
      </a>
      <a class="card card-photo reveal" href="/writing/">
        <img src="/assets/img/press/conducting-bw-web.jpg" alt="" width="960" height="960" loading="lazy" style="object-position:50% 40%">
        <h3>Writing &amp; scholarship</h3>
        <p>Articles, lectures, and choral music, published by GIA, MusicSpoke, and the Hymn Society.</p>
        <span class="go">Read the work &rarr;</span>
      </a>
    </div>
  </div>
</section>

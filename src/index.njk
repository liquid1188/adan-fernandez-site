---
layout: base.njk
permalink: /
active: home
---
{%- set feat = [] %}
{%- for id in videos.featured %}{% for v in videos.items %}{% if v.id == id %}{% set feat = (feat.push(v), feat) %}{% endif %}{% endfor %}{% endfor %}
{%- set next = performances.items | upcoming | limit(3) %}

<section class="hero">
  <img class="hero-img" src="/assets/img/hero-organ.jpg" alt="Adán Fernández at the organ console" width="1920" height="1280" fetchpriority="high">
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <p class="eyebrow">{{ site.roles }}</p>
    <h1>Adán Alejándro<br>Fernández</h1>
    <p class="hero-sub"><strong>Director of Music &amp; Liturgy and Organist</strong>, Holy Family Catholic Church, Glendale &nbsp;·&nbsp; <strong>University Organist</strong>, California Lutheran University</p>
    <div class="cta-row">
      <a class="btn btn-brass" href="/listen/">Hear him play</a>
      <a class="btn btn-ghost" href="/contact/">Book a date</a>
    </div>
  </div>
</section>

<div class="roles-strip">
  <div class="wrap">
    <span><b>Organ</b> recitals &amp; residencies</span>
    <span><b>Harpsichord</b> &amp; early music</span>
    <span><b>Conducting</b> choral &amp; orchestral</span>
    <span><b>Lectures</b> on Latin American sacred music</span>
  </div>
</div>

<section class="section">
  <div class="wrap two-col">
    <div class="reveal">
      <div class="rule-head"><span class="lbl">Biography</span><span class="rule"></span></div>
      <div class="prose">
        <p class="first">{{ bio.long[0] }}</p>
        <p>{{ bio.long[1] }}</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-outline" href="/about/">Read the full biography</a>
      </div>
    </div>
    <figure class="portrait-frame reveal" style="margin:0">
      <img src="/assets/img/portrait.jpg" alt="Portrait of Adán Fernández" width="1200" height="1200" loading="lazy">
    </figure>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Watch &amp; listen</span><span class="rule"></span></div>
    <h2 class="reveal">At the console, and in front of the choir.</h2>
    <p class="lede reveal" style="margin-top:1rem;margin-bottom:2.6rem">Ives on the organ, Locklair's <em>Rubrics</em>, and the Padilla villancicos — sung for the first time in three hundred years.</p>
    <div class="video-grid">
    {%- for v in feat %}
      <figure class="vid reveal">
        <div class="frame" data-yt="{{ v.id }}" role="button" tabindex="0" aria-label="Play {{ v.piece }} by {{ v.composer }}">
          <img src="https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        </div>
        <figcaption><span class="piece">{{ v.piece }}</span><span class="composer">{{ v.composer }}</span>{% if v.note %}<span class="note">{{ v.note }}</span>{% endif %}</figcaption>
      </figure>
    {%- endfor %}
    </div>
    <div class="cta-row"><a class="btn btn-ghost" href="/listen/">All recordings</a></div>
  </div>
</section>

{%- if next | length %}
<section class="section tint">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Next</span><span class="rule"></span></div>
    <ol class="events">
    {%- for e in next %}
      <li class="event reveal">
        <div class="date"><span class="m">{{ e.date | mon }}</span><span class="d">{{ e.date | day }}</span><span class="y">{{ e.date | year }}</span></div>
        <div>
          <h3>{{ e.title }}{% if e.tag %}<span class="tag">{{ e.tag }}</span>{% endif %}</h3>
          <p>{{ e.venue }} &middot; {{ e.city }}</p>
        </div>
      </li>
    {%- endfor %}
    </ol>
    <div class="cta-row"><a class="btn btn-outline" href="/upcoming/">Full calendar</a></div>
  </div>
</section>
{%- endif %}

<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Work with Adán</span><span class="rule"></span></div>
    <div class="cards">
      <a class="card reveal" href="/performing/">
        <h3>Performing</h3>
        <p>Organ and harpsichord recitals, concerto appearances, and conducting engagements, from parish lofts to Walt Disney Concert Hall.</p>
        <span class="go">See the repertoire &rarr;</span>
      </a>
      <a class="card reveal" href="/teaching/">
        <h3>Teaching</h3>
        <p>An organ studio at Cal Lutheran, theory at the Colburn School, and masterclasses and residencies for church musicians.</p>
        <span class="go">What he teaches &rarr;</span>
      </a>
      <a class="card reveal" href="/writing/">
        <h3>Writing &amp; scholarship</h3>
        <p>Published on liturgy, hymnody, and the sacred music of Latin America, with choral editions from GIA and MusicSpoke.</p>
        <span class="go">Read the work &rarr;</span>
      </a>
    </div>
  </div>
</section>

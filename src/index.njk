---
layout: base.njk
permalink: /
active: home
---
{%- set feat = [] %}
{%- for id in videos.featured %}{% for v in videos.items %}{% if v.id == id %}{% set feat = (feat.push(v), feat) %}{% endif %}{% endfor %}{% endfor %}
{%- set next = performances.items | upcoming | limit(3) %}

<section class="hero">
  <img class="hero-img" src="/assets/img/hero-organ.jpg" alt="Adán Fernández at the organ console" width="1920" height="1280" fetchpriority="high">
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <p class="eyebrow hero-eyebrow">{{ site.roles }}</p>
    <h1>Adán Alejándro<br>Fernández</h1>
    <p class="hero-sub"><span class="line"><strong>Director of Music and Liturgy</strong>, Holy Family Catholic Church, Glendale</span><span class="line"><strong>University Organist</strong>, California Lutheran University</span></p>
    <div class="cta-row">
      <a class="btn btn-brass" href="/listen/">Hear him play</a>
      <a class="btn btn-ghost" href="/contact/">Book a recital</a>
    </div>
  </div>
</section>

<div class="statement">
  <div class="wrap">
    <p>Working where the pipe organ, the Catholic liturgy, and the sacred music of <em>Latin America</em> meet.</p>
  </div>
</div>

<div class="press-strip">
  <div class="wrap">
    <p class="press-label">{{ press.label }}</p>
    <ul class="press-row">
    {%- for p in press.items %}
      <li>{% if p.url %}<a href="{{ p.url }}" rel="noopener">{{ p.name }}</a>{% else %}<span>{{ p.name }}</span>{% endif %}</li>
    {%- endfor %}
    </ul>
  </div>
</div>

<section class="section">
  <div class="wrap two-col">
    <div class="reveal">
      <div class="rule-head"><span class="lbl">Biography</span><span class="rule"></span></div>
      <div class="prose">
        <p class="first">{{ bio.short }}</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-outline" href="/about/">Read the full biography</a>
      </div>
    </div>
    <figure class="portrait-frame round reveal" style="margin:0;max-width:420px">
      <img src="/assets/img/headshot-circle.jpg" alt="Portrait of Adán Fernández" width="750" height="750" loading="lazy">
    </figure>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Listen</span><span class="rule"></span></div>
    <h2 class="reveal">At the console, and in front of the <em>choir.</em></h2>
    <p class="lede reveal" style="margin-top:1rem;margin-bottom:2.6rem">Three recordings to start with.</p>
    <div class="video-grid">
    {%- for v in feat %}
      <figure class="vid reveal">
        <button type="button" class="frame" data-yt="{{ v.id }}" aria-label="Play {{ v.piece }} by {{ v.composer }}">
          <img src="https://i.ytimg.com/vi/{{ v.id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg'" alt="" loading="lazy" width="1280" height="720">
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        </button>
        <figcaption><span class="piece">{{ v.piece }}</span><span class="composer">{{ v.composer }}</span>{% if v.note %}<span class="note">{{ v.note }}</span>{% endif %}</figcaption>
      </figure>
    {%- endfor %}
    </div>
    <div class="cta-row"><a class="btn btn-ghost" href="/listen/">All recordings</a></div>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Try it</span><span class="rule"></span></div>
    <h2 class="reveal" style="margin-bottom:2rem">Now you play the <em>pipes.</em></h2>
    <div class="organ-widget reveal">
      <div class="organ-facade" id="organFacade" aria-label="Playable organ pipes"></div>
      <div class="organ-console">
        <div class="organ-controls" aria-label="Organ controls">
          <button class="organ-btn" id="organHoverToggle" type="button" aria-pressed="false">Hover play</button>
          <span class="organ-touch-hint">Drag across the keys to play</span>
          <label class="organ-volume">Volume <input id="organVolume" type="range" min="0" max="100" value="58"></label>
        </div>
        <div class="organ-keyboard" id="organKeyboard" aria-label="Two-octave organ keyboard"></div>
      </div>
    </div>
  </div>
</section>

{%- if next | length %}
{% if quotes.featured.quote %}
<section class="band-quote">
  <div class="wrap">
    <blockquote class="big-q">
      <span class="qmark" aria-hidden="true">&ldquo;</span>
      <p>{{ quotes.featured.quote | safe }}</p>
      <cite><span class="q-name">{{ quotes.featured.name }}</span>{% if quotes.featured.role %}<span class="q-role">{{ quotes.featured.role }}</span>{% endif %}</cite>
    </blockquote>
    {%- if quotes.supporting | length %}
    <div class="q-two">
    {%- for q in quotes.supporting %}
      <blockquote class="q-small">
        <p>{{ q.quote | safe }}</p>
        <cite><span class="q-name">{{ q.name }}</span>{% if q.role %}<span class="q-role">{{ q.role }}</span>{% endif %}</cite>
      </blockquote>
    {%- endfor %}
    </div>
    {%- endif %}
  </div>
</section>
{% endif %}

<section class="feature">
  <picture><source media="(max-width: 720px)" srcset="/assets/img/press/cathedral-offcenter-mobile.jpg" width="1206" height="1100"><img class="feature-img" src="{{ feature.imageWeb or feature.image }}" alt="" width="1206" height="750" loading="lazy" sizes="100vw"></picture>
  <div class="wrap">
    <div class="feature-copy">
      <p class="kicker">{{ feature.kicker }}</p>
      <h2>{{ feature.title }}</h2>
      <p class="feature-body">{{ feature.body | safe }}</p>
      <div class="cta-row">
      {%- for a in feature.actions %}
        <a class="btn {% if a.primary %}btn-brass{% else %}btn-ghost{% endif %}" href="{{ a.href }}">{{ a.label }}</a>
      {%- endfor %}
      </div>
    </div>
  </div>
  <p class="feature-credit">{{ feature.credit }}</p>
</section>

<section class="section tint">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Next</span><span class="rule"></span></div>
    <ol class="events">
    {%- for e in next %}
      <li class="event reveal">
        <div class="date"><span class="m">{{ e.date | mon }}</span><span class="d">{{ e.date | day }}</span><span class="y">{{ e.date | year }}</span></div>
        <div>
          <h3>{{ e.title }}{% if e.tag %}<span class="tag">{{ e.tag }}</span>{% endif %}</h3>
          <p>{{ e.venue }} &middot; {{ e.city }}</p>
        </div>
      </li>
    {%- endfor %}
    </ol>
    <div class="cta-row"><a class="btn btn-outline" href="/calendar/">Full calendar</a></div>
  </div>
</section>
{%- endif %}


<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">In print</span><span class="rule"></span></div>
    <div class="feat-grid">
    {%- for f in writing.featured | limit(2) %}
      <article class="feat reveal{% if f.page %} has-page{% endif %}">
        {%- if f.page %}<a class="feat-page" href="{{ f.link }}" rel="noopener" tabindex="-1" aria-hidden="true"><img src="{{ f.page }}" alt="" width="560" height="792" loading="lazy"></a>{% endif %}
        <div class="feat-body">
        <p class="feat-kicker">{{ f.kicker }}</p>
        <p class="feat-cite">{{ f.cite }}</p>
        <h3><a href="{{ f.link }}" rel="noopener">{{ f.title }}</a></h3>
        <a class="go" href="{{ f.link }}" rel="noopener">{{ f.cta }} &rarr;</a>
        </div>
      </article>
    {%- endfor %}
    </div>
    <div class="cta-row"><a class="btn btn-outline" href="/writing/">All writing and scholarship</a></div>
  </div>
</section>

<section class="affil">
  <div class="wrap">
    <p class="eyebrow" style="text-align:center">Affiliations</p>
    <ul class="affil-row">
    {%- for a in affiliations.items %}
      <li><a href="{{ a.url }}" rel="noopener" title="{{ a.name }}">{% if a.img %}<img src="{{ a.img }}" alt="{{ a.name }}" width="{{ a.w }}" height="{{ a.h }}" loading="lazy">{% else %}<span class="wordmark">{{ a.text }}{% if a.sub %}<small>{{ a.sub }}</small>{% endif %}</span>{% endif %}</a></li>
    {%- endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Work with Adán</span><span class="rule"></span></div>
    <div class="cards numbered">
      <a class="card card-photo reveal" href="/performing/">
        <img src="/assets/img/press/console-bw-smiling.jpg" alt="" width="1206" height="1500" loading="lazy" style="object-position:50% 8%">
        <h3>Performing</h3>
        <p>Organ and harpsichord recitals, concerto appearances, and conducting engagements, from parish churches to Walt Disney Concert Hall.</p>
        <span class="go">See the repertoire &rarr;</span>
      </a>
      <a class="card card-photo reveal" href="/teaching/">
        <img src="/assets/img/press/childrens-choir.jpg" alt="" width="1206" height="1499" loading="lazy" style="object-position:50% 45%">
        <h3>Teaching</h3>
        <p>An organ and piano studio at Cal Lutheran, theory at the Colburn School, and masterclasses and residencies for church musicians.</p>
        <span class="go">What he teaches &rarr;</span>
      </a>
      <a class="card card-photo reveal" href="/writing/">
        <img src="/assets/img/pubs/religions-2025.jpg" alt="" width="560" height="792" loading="lazy" style="object-position:50% 0%">
        <h3>Writing &amp; scholarship</h3>
        <p>Articles, lectures, and choral music, published by GIA, MusicSpoke, and the Hymn Society.</p>
        <span class="go">Read the work &rarr;</span>
      </a>
    </div>
  </div>
</section>

<section class="mailing">
  <div class="wrap">
    <div class="ml-inner">
      <div class="ml-text">
        <h3>Join the mailing list.</h3>
        <p>Recital dates and new writing, a few times a year.</p>
      </div>
      <form class="ml-form" action="https://formsubmit.co/{{ site.email }}" method="POST">
        <input type="hidden" name="_subject" value="Mailing list signup">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
        <label class="sr-only" for="ml-email">Email address</label>
        <input id="ml-email" type="email" name="email" placeholder="Email address" required>
        <button type="submit" class="btn btn-brass">Subscribe</button>
      </form>
    </div>
  </div>
</section>

---
layout: base.njk
permalink: /calendar/
active: calendar
bodyClass: on-paper
title: Calendar
description: "Upcoming and recent performances by Adán Fernández: organ and harpsichord recitals, conducting engagements, and festival appearances."
---
{%- set next = performances.items | upcoming %}
{%- set gone = performances.items | past %}
<section class="page-head split">
  <div class="wrap">
  <div class="head-text">
    <p class="eyebrow">Calendar</p>
    <h1>Where to hear him.</h1>
    <p class="lede">Recitals, services, and concerts, with the venue for each.</p>
  </div>
  <figure class="head-photo"><img src="/assets/img/press/conducting-church-web.jpg" alt="" width="960" height="958" style="object-position:55% 20%" loading="eager"></figure>
  </div>
</section>

{%- if next | length %}
<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Upcoming</span><span class="rule"></span></div>
    <ol class="events">
    {%- for e in next %}
      <li class="event reveal">
        <div class="date"><span class="m">{{ e.date | mon }}</span><span class="d">{{ e.date | day }}</span><span class="y">{{ e.date | year }}</span></div>
        <div>
          <h3>{{ e.title }}{% if e.tag %}<span class="tag">{{ e.tag }}</span>{% endif %}</h3>
          <p>{{ e.venue }} &middot; {{ e.city }}</p>
          <p class="fine">{{ e.date | longDate }}</p>
        </div>
      </li>
    {%- endfor %}
    </ol>
    <p class="fine reveal" style="margin-top:1.6rem">New dates go up as they are confirmed. To book one, <a href="/contact/" style="border-bottom:1px solid var(--brass-deep)">get in touch</a>. The full engagement history is in his <a href="{{ site.cv }}" download style="border-bottom:1px solid var(--brass-deep)">curriculum vitae</a>.</p>
  </div>
</section>
{%- endif %}

{%- if gone | length %}
<section class="section">
  <div class="wrap">
    <div class="rule-head reveal"><span class="lbl">Recent</span><span class="rule"></span></div>
    <ol class="events">
    {%- for e in gone %}
      <li class="event reveal">
        <div class="date"><span class="m">{{ e.date | mon }}</span><span class="d">{{ e.date | day }}</span><span class="y">{{ e.date | year }}</span></div>
        <div>
          <h3>{{ e.title }}{% if e.tag %}<span class="tag">{{ e.tag }}</span>{% endif %}</h3>
          <p>{{ e.venue }} &middot; {{ e.city }}</p>
        </div>
      </li>
    {%- endfor %}
    </ol>
    <p class="fine reveal" style="margin-top:1.6rem">New dates go up as they are confirmed. To book one, <a href="/contact/" style="border-bottom:1px solid var(--brass-deep)">get in touch</a>. The full engagement history is in his <a href="{{ site.cv }}" download style="border-bottom:1px solid var(--brass-deep)">curriculum vitae</a>.</p>
  </div>
</section>
{%- endif %}
